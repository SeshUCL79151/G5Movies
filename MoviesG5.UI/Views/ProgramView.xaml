<UserControl x:Class="MoviesG5.UI.ProgramView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        d:DesignHeight="750" d:DesignWidth="1000">
    <Grid Margin="10" Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="20"/>
            <!-- "Vælg en film fra oversigten" -->
            <RowDefinition Height="210"/>
            <!-- Movie list -->
            <RowDefinition Height="25"/>
            <!-- Month navigation -->
            <RowDefinition Height="*"/>
            <!-- Screenings list -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <!-- Main content -->
            <ColumnDefinition Width="Auto"/>
            <!-- Sidebar -->
        </Grid.ColumnDefinitions>

        <!-- Header text -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Vælg en film fra listen"
               HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="13"/>

        <!-- Movie list -->
        <ListView Grid.Column="0" ItemsSource="{Binding Movies}"
          Width="590" Height="200" Margin="0,0,10,10" FontSize="13" Grid.Row="1"
          SelectedItem="{Binding SelectedMovie}">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="4,0"/>
                    <Setter Property="Height" Value="22"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <GridView.Columns>
                        <GridViewColumn Header="Titel" Width="200" DisplayMemberBinding="{Binding Title}"/>
                        <GridViewColumn Header="Instruktør" Width="200" DisplayMemberBinding="{Binding Director}"/>
                        <GridViewColumn Header="Varighed" Width="60" DisplayMemberBinding="{Binding Duration, StringFormat='{}{0:%h}:{0:mm}'}"/>
                        <GridViewColumn Header="Genre" Width="120" DisplayMemberBinding="{Binding Genre}"/>
                    </GridView.Columns>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Month navigation -->
        <Grid Grid.Row="2" Grid.Column="0" Margin="0,0,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="⬅" Command="{Binding PreviousMonthCommand}"/>
            <TextBlock Grid.Column="1" Text="{Binding MonthName}" FontSize="24"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Button Grid.Column="2" Content="➡" Command="{Binding NextMonthCommand}"/>
        </Grid>

        <!-- Screenings list -->
        <Grid Grid.Row="3" Grid.Column="0" Margin="0,10,10,0">
            <ListView FontSize="13" ItemsSource="{Binding PlannedScreenings}"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.Style>
                    <Style TargetType="ListView">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedScreen}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListView.Style>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="4,0"/>
                        <Setter Property="Height" Value="21"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView>
                        <GridView.Columns >
                            <GridViewColumn Header="Dato" Width="40" DisplayMemberBinding="{Binding DateText}"/>
                            <GridViewColumn Header="1. forestilling" Width="210" DisplayMemberBinding="{Binding ScreeningText[0]}"/>
                            <GridViewColumn Header="2. forestilling" Width="210" DisplayMemberBinding="{Binding ScreeningText[1]}"/>
                            <GridViewColumn Header="3. forestilling" Width="210" DisplayMemberBinding="{Binding ScreeningText[2]}"/>
                        </GridView.Columns>
                    </GridView>
                </ListView.View>
            </ListView>

            <TextBlock Text="Vælg sal" FontSize="32" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedScreen}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <!-- Sidebar: -->
        <StackPanel Grid.Row="0" Grid.RowSpan="4" Grid.Column="1" Width="220">
            <TextBlock  Grid.Row="5" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Text="Vælg biograf" FontSize="13"/>
            <ComboBox Grid.Row="5" Grid.Column="2" FontSize="13" VerticalContentAlignment="Center" Width="200" Height="25" Margin="0,10,0,0" ItemsSource="{Binding Cinemas}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedCinema}"/>
            <TextBlock  Grid.Row="5" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Text="Vælg sal" FontSize="13"/>
            <ComboBox Grid.Row="5" Grid.Column="2" FontSize="13" VerticalContentAlignment="Center" Width="50" Height="25" Margin="0,10,0,0" ItemsSource="{Binding SelectedCinema.Screens}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedScreen}"/>

            <Grid Margin="0,0,0,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="30"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock  Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Text="Vælg startdato" FontSize="13"/>
                <TextBlock  Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Text="Vælg slutdato" FontSize="13"/>
                <DatePicker Grid.Row="1" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="13" SelectedDate="{Binding StartDate}"/>
                <DatePicker Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="13" SelectedDate="{Binding EndDate}"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" Text="Indtast starttidspunkt (timer:minutter)" FontSize="13"/>
                <TextBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Width="38" Height="25" Text="{Binding StartTimeInput}" FontSize="13" VerticalContentAlignment="Center"/>
            </Grid>

            

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Gem" Margin="0,0,5,0" Height="30" Command="{Binding AddScreeningsCommand}"/>
                <Button Grid.Column="1" Content="Ryd" Margin="5,0,0,0" Height="30" Command="{Binding ClearFormCommand}"/>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
