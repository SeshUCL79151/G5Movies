<Window x:Class="MoviesG5.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MoviesG5.UI"
        Title="The Movies" Height="700" Width="960">
    <TabControl>
        <TabItem Header="Velkommen" Height="40" Width="125" FontSize="16">
            <views:WelcomeView />
        </TabItem>
        <TabItem Header="Registrer film" Height="40" Width="125" FontSize="16">
            <views:MovieView DataContext="{Binding MovieViewModel}" />
        </TabItem>
        <TabItem Header="Læg program" Height="40" Width="125" FontSize="16">
            <views:ProgramView DataContext="{Binding ProgramViewModel}" />
        </TabItem>
        
    </TabControl>
</Window>
